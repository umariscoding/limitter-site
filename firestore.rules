rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Blocked Sites ───
    // get = single doc read (resource.data works)
    // list = collection query (resource.data does NOT work, must allow and rely on query filters)
    match /blocked_sites/{siteId} {
      allow get: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || isAdmin()
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.user_id == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── Subscriptions ───
    match /subscriptions/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Subscription Plans (read-only reference data) ───
    match /subscription_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── User Overrides ───
    match /user_overrides/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Transactions ───
    // get = single doc, list = query (user queries with where user_id == uid)
    match /transactions/{transactionId} {
      allow get: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || isAdmin()
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.user_id == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── User Activity ───
    match /user_activity/{activityId} {
      allow get: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || isAdmin()
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.user_id == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ─── Override History (immutable) ───
    match /override_history/{historyId} {
      allow get: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || isAdmin()
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.user_id == request.auth.uid
      );
      allow update: if false;
      allow delete: if false;
    }

    // ─── Contact Messages ───
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ─── Admin Collections ───
    match /admin_stats/{docId} {
      allow read, write: if isAdmin();
    }

    match /admin_audit/{docId} {
      allow read, write: if isAdmin();
    }

    match /admin_audit_log/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── Accounts (API backend sub-collections) ───
    match /accounts/{accountId} {
      allow read: if isAuthenticated() && (isOwner(accountId) || isAdmin());
      allow write: if isAdmin();

      match /policies/{policyId} {
        allow read: if isAuthenticated() && (isOwner(accountId) || isAdmin());
        allow write: if isAdmin();
      }

      match /devices/{deviceId} {
        allow read: if isAuthenticated() && (isOwner(accountId) || isAdmin());
        allow write: if isAdmin();
      }

      match /overrides/{overrideId} {
        allow read: if isAuthenticated() && (isOwner(accountId) || isAdmin());
        allow write: if isAdmin();
      }

      match /override_counters/{monthKey} {
        allow read: if isAuthenticated() && (isOwner(accountId) || isAdmin());
        allow write: if isAdmin();
      }

      match /purchases/{purchaseId} {
        allow read: if isAuthenticated() && (isOwner(accountId) || isAdmin());
        allow write: if isAdmin();
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isAuthenticated() && (isOwner(accountId) || isAdmin());
        allow write: if isAdmin();
      }

      match /audit_logs/{logId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    
    // Admin collections - only accessible by admins
    match /admin_stats/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /admin_audit/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /admin_audit_log/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Contact messages - anyone can create, admins can read/update/delete
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated() && isAdmin();
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
